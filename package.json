{
  "name": "scraply",
  "version": "0.2.0",
  "bin": {
    "scraply": "src/cli/main.ts"
  },
  "description": "A command-line tool that turns a rough seed into an idea that survived tests against evidence.",
  "author": "Dany",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "scraply": "bun src/cli/main.ts",
    "test": "bun test ./test/unit && bun test --timeout 30000 ./test/integration",
    "test:exa": "bun test test/integration/exa.live.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "eslint": "^10.9.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
