{
  "name": "scraply",
  "version": "0.3.0",
  "description": "Local-first evidence-backed research and idea exploration desktop app.",
  "author": "Dany",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --win --publish never",
    "install:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-local.ps1",
    "build:installed": "bun run package && bun run install:local",
    "test": "bun test test/unit test/integration/backend.test.ts test/integration/recovery.test.ts test/integration/evidence-model.test.ts test/integration/idea-generation.test.ts test/integration/research-limits.test.ts",
    "test:e2e": "playwright test",
    "test:exa": "bun test test/integration/exa.live.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json",
    "check": "bun run typecheck && svelte-check --tsconfig ./tsconfig.renderer.json && bun run test"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "jsdom": "^26.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.2.22",
    "@types/jsdom": "^21.1.7",
    "electron": "42.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "tar": "7.5.20"
  },
  "build": {
    "appId": "com.scraply.app",
    "productName": "Scraply",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "prompts/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
