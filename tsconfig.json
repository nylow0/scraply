{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun-types", "node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@db/*": ["src/db/*"],
      "@providers/*": ["src/providers/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/backend/**/*",
    "src/core/**/*",
    "src/db/**/*",
    "src/providers/**/*",
    "src/research/**/*",
    "src/shared/**/*",
    "test/**/*",
    "electron.vite.config.ts"
  ],
  "exclude": ["src/renderer/**/*", "node_modules", "out", "release", "archive/**/*", "test/phase*.test.ts", "test/pipeline.test.ts", "test/embeddings.test.ts", "test/exa.test.ts", "test/opencode.test.ts"]
}
